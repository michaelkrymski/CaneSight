# Non-secret deployment settings. Fill with reviewed immutable images.
CANESIGHT_DOMAIN=
BACKEND_IMAGE=
CADDY_IMAGE=
# Only the production backend or a reviewed SSH laptop tunnel is allowed.
CANESIGHT_UPSTREAM=127.0.0.1:18083
# To preserve an existing bootstrap certificate, use its actual volume names.
CADDY_DATA_VOLUME=canesight_caddy_data
CADDY_CONFIG_VOLUME=canesight_caddy_config
