{
    admin off
    default_sni {$CANESIGHT_DOMAIN}
}

{$CANESIGHT_DOMAIN} {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
    header Cache-Control "no-store"
    # Automatic HTTPS and WebSocket upgrades are handled by Caddy.
    # Do not enable request access logs: URLs may identify demo sessions.
    reverse_proxy {$CANESIGHT_UPSTREAM:127.0.0.1:18083} {
        transport http {
            dial_timeout 3s
            response_header_timeout 10s
        }
    }
}
