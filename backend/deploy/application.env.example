# Install only on the server as secrets/application.env, mode 0600.
# Overlay explicitly selects accepted context composition; choose exactly
# sessions, dashboard or logging for CANESIGHT_CONTEXT_BASE after review.
CANESIGHT_CONTEXT_BASE=sessions
# Configure server-only GEMINI_API_KEY and independently verified
# CANESIGHT_GEMINI_MODEL privately. Never put actual values in Git/chat/CLI args.
# dashboard/logging also need exact HTTPS CANESIGHT_DASHBOARD_ORIGIN.
# logging additionally needs private CANESIGHT_EVENT_DB_CONFIG pointing to a file
# under /run/canesight-application, readable only by runtime UID 10001.
# Per-session event logging consent remains default-off.
