          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "t1_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "type",
        "session_id",
        "mode",
        "nonce",
        "receiver_id",
        "receiver_boot_id",
        "source_id",
        "source_boot_id",
        "t1_ms"
      ],
      "additionalProperties": false
    },
    "clock_reply": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "const": "clock_reply"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "mode": {
          "enum": [
            "live",
            "replay"
          ]
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "receiver_id": {
