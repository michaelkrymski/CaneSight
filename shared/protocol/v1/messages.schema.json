          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "t1_ms": {
          "type": "number",
          "minimum": 0
        },
        "t2_ms": {
          "type": "number",
          "minimum": 0
        },
        "t3_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "type",
        "session_id",
        "mode",
        "nonce",
        "receiver_id",
        "receiver_boot_id",
